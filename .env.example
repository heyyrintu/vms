DJANGO_SECRET_KEY=replace-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
LOGIN_THROTTLE_RATE=10/minute
# Mandatory in production (DJANGO_DEBUG=false). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating it makes stored SMTP, WhatsApp, MFA and bank secrets unreadable.
FIELD_ENCRYPTION_KEY=
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOCAL_DEV_PORTS=3000,3001,3002,3003,3004,3005
DATABASE_URL=postgresql://vms:vms@postgres:5432/vms
REDIS_URL=redis://redis:6379/0
INTEGRATION_DELIVERY_MODE=async
WEB_ORIGIN=http://localhost:3000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=vms-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
USE_S3_STORAGE=false
CLAMAV_HOST=
CLAMAV_PORT=3310
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM_NAME=
SMTP_REPLY_TO=
EMAIL_BRAND_NAME=Drona Logitech
EMAIL_BRAND_TAGLINE=Vehicle Management System
EMAIL_BRAND_ADDRESS=
EMAIL_SUPPORT_EMAIL=
EMAIL_LOGO_URL=
EMAIL_PRIMARY_COLOR=#d71920
EMAIL_WEBHOOK_TOKEN=
WHATSAPP_PROVIDER=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Sent as a body parameter of the vms_login AUTHENTICATION template, which Meta
# limits to 15 characters; longer values are clamped before sending.
OTP_APP_LABEL=Drona Logitech
WHATSAPP_LOGIN_OTP_TEMPLATE_NAME=vms_login
WHATSAPP_LOGIN_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PASSWORD_RECOVERY_TEMPLATE_NAME=password_recovery
WHATSAPP_PASSWORD_RECOVERY_TEMPLATE_LANGUAGE=en_US
# Both OTP templates are AUTHENTICATION category with a copy-code URL button,
# so the send must include the button parameter. Use "url"; "none" makes Meta
# reject the send with 132000 and no code is delivered.
WHATSAPP_OTP_BUTTON_TYPE=url
WHATSAPP_APPROVAL_TEMPLATE_NAME=drona_logitech_approval_review
WHATSAPP_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_APPROVAL_EXPIRY_SECONDS=604800
WHATSAPP_FINANCE_TEMPLATE_NAME=drona_logitech_finance_ready
WHATSAPP_FINANCE_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_APPROVAL_TEMPLATE_NAME=drona_logitech_operations_approval
WHATSAPP_OPERATIONS_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_PAYMENT_TEMPLATE_NAME=drona_logitech_operations_payment
WHATSAPP_OPERATIONS_PAYMENT_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_SETTLEMENT_TEMPLATE_NAME=drona_logitech_operations_settlement
WHATSAPP_OPERATIONS_SETTLEMENT_TEMPLATE_LANGUAGE=en

# Set to false to make WhatsApp quick-reply buttons record-only (decisions then happen in-app)
WHATSAPP_INTERACTIVE_DECISIONS=true
