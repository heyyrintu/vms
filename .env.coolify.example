# Public URL (do not add a trailing slash)
APP_HOST=vms.yourcompany.com
APP_URL=https://vms.yourcompany.com

# Generate both values; never reuse development values
DJANGO_SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me

# Coolify generates these SERVICE_* values automatically
SERVICE_USER_POSTGRES=
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_REDIS=
SERVICE_USER_MINIO=
SERVICE_PASSWORD_MINIO=

# Optional tuning
POSTGRES_DB=vms
BUSINESS_TIMEZONE=Asia/Kolkata
LOGIN_THROTTLE_RATE=10/minute
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
CELERY_WORKER_CONCURRENCY=2
AWS_STORAGE_BUCKET_NAME=vms-documents
AWS_S3_REGION_NAME=us-east-1

# SMTP
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Drona Logitech <no-reply@yourcompany.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM_NAME=
SMTP_REPLY_TO=
EMAIL_BRAND_NAME=Drona Logitech
EMAIL_BRAND_TAGLINE=Vehicle Management System
EMAIL_BRAND_ADDRESS=
EMAIL_SUPPORT_EMAIL=
EMAIL_LOGO_URL=
EMAIL_PRIMARY_COLOR=#d71920
EMAIL_WEBHOOK_TOKEN=change-me

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me

# Approved Meta template names/languages
WHATSAPP_APPROVAL_TEMPLATE_NAME=drona_logitech_approval_review
WHATSAPP_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_FINANCE_TEMPLATE_NAME=drona_logitech_finance_ready
WHATSAPP_FINANCE_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_APPROVAL_TEMPLATE_NAME=drona_logitech_operations_approval
WHATSAPP_OPERATIONS_APPROVAL_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_PAYMENT_TEMPLATE_NAME=drona_logitech_operations_payment
WHATSAPP_OPERATIONS_PAYMENT_TEMPLATE_LANGUAGE=en
WHATSAPP_OPERATIONS_SETTLEMENT_TEMPLATE_NAME=drona_logitech_operations_settlement
WHATSAPP_OPERATIONS_SETTLEMENT_TEMPLATE_LANGUAGE=en
